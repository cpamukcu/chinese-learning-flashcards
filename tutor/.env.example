# Copy to .env.local and fill in. Never commit .env.local.
#
# Only variables prefixed NEXT_PUBLIC_ reach the browser. Everything else is
# server-only and is read exclusively through src/lib/env.server.ts.

# --- LLM (server-only) — used from Milestone 2 ---
# TUTOR_PROVIDER picks the model backend:
#   openai-compatible  Zhipu / DeepSeek / Qwen / Kimi… works inside mainland China
#   anthropic          Claude (paid; NOT available in mainland China)
#   ollama             free model on your own machine (no key)
# Unset = whichever key is present (Claude, then LLM_API_KEY), otherwise Ollama.
TUTOR_PROVIDER=

# For TUTOR_PROVIDER=openai-compatible (defaults shown are Zhipu's free GLM-4-Flash):
LLM_API_KEY=
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

ANTHROPIC_API_KEY=
# Optional Ollama settings (defaults shown):
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434

# --- Speech (server-only) — used from Milestone 3; provider is chosen then ---
STT_API_KEY=
TTS_API_KEY=

# --- Supabase ---
# Project Settings → API. The anon key is safe for the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Login without Supabase (works in China) ---
# Set a password (8+ characters) and the site asks for it instead of email/Google.
# For a private group of friends; everyone shares one password.
ACCESS_PASSWORD=

# --- Local development only ---
# Set to true to skip login entirely (no Supabase needed). Ignored in
# production builds, so it can never disable auth on a deployed site.
DEV_SKIP_AUTH=
